{
  "name": "pass-atelier",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "prebuild": "node scripts/collect-notices.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests scripts docs *.json *.ts *.html *.md",
    "package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "imagetracerjs": "^1.2.6",
    "lucide-react": "^0.468.0",
    "manifold-3d": "^3.3.2",
    "opentype.js": "1.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svg-path-parser": "^1.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/opentype.js": "^1.3.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "license": "MIT",
  "description": "浏览器里的多色3D打印通行证与徽章设计台",
  "repository": {
    "type": "git",
    "url": "https://github.com/lilisanae/sanae-pass-atelier.git"
  },
  "homepage": "https://beatsanae.cn/pass/",
  "bugs": {
    "url": "https://github.com/lilisanae/sanae-pass-atelier/issues"
  }
}
